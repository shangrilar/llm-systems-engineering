---
import {localeFromPath} from '../i18n/index';
interface Props { id: string; alt: string }
const {id,alt}=Astro.props;
if(!/^rl-\d{2}\/[a-z0-9-]+$/.test(id))throw new Error('Invalid RL figure ID');
const locale=localeFromPath(Astro.url.pathname);
const [articleId,figureId]=id.split('/');
const base=`/images/${articleId}/${locale==='en'?'en/':''}${figureId}`;
---
<figure class="rl-figure" data-figure-id={id}>
  <a href={`${base}.png`} aria-label={locale==='en'?'Open full-size figure':'그림 원본 열기'}>
    <picture><source media="(max-width: 640px)" srcset={`${base}-mobile.png`} /><img src={`${base}.png`} alt={alt} loading="lazy" decoding="async" /></picture>
  </a>
</figure>
<style>
  .rl-figure { margin: 32px 0; }
  .rl-figure img { display: block; width: 100%; height: auto; }
</style>

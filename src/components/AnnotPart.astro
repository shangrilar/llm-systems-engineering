---
// One region of an <Annot> figure (panels "1", "2", "1+2" or "all") with its note as children. A region whose
// panels are not adjacent on a screen is shown as one crop per panel there (see panelCrops). With `only`, the
// desktop part is inline SVG that hides the other steps of a one-panel flow diagram (see inlineSlice).
import {localeFromPath} from '../i18n/index';
import {figureSpec,panelCrops,cropStyle,hasMobile,inlineSlice} from './annot';
interface Props{fig:string;panels:string;xr?:string;yr?:string;only?:string}
const {fig,panels,xr,yr,only}=Astro.props;
const locale=localeFromPath(Astro.url.pathname);
const spec=await figureSpec(fig);
const desks=panelCrops(spec,fig,locale,false,panels,xr,yr),mobs=hasMobile(spec)?panelCrops(spec,fig,locale,true,panels):[];
const desk=desks[0];
const key='as-'+`${fig}-${only}-${yr}`.replace(/[^a-z0-9]+/g,'-');
---
<div class="annot-part" data-panels={panels} style={`--cw:${Math.round(desk.box[2]*1016/1200)}px`}>
  <div>
    {only?<div class={`annot-crop${mobs.length?' annot-desktop':''}`} style={`max-width:${Math.round(desk.box[2]*1016/1200)}px`} set:html={inlineSlice(fig,locale,desk,only,key)} />
      :desks.map(c=>{const s=cropStyle(c);return <div class={`annot-crop${mobs.length?' annot-desktop':''}`} style={s.wrap}><img src={c.src} style={s.img} alt="" aria-hidden="true" loading="lazy" decoding="async" /></div>;})}
    {mobs.map(c=>{const s=cropStyle(c,true);return <div class="annot-crop annot-mobile" style={s.wrap}><img src={c.src} style={s.img} alt="" aria-hidden="true" loading="lazy" decoding="async" /></div>;})}
  </div>
  <div class="annot-note"><slot /></div>
</div>

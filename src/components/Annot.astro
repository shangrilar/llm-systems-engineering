---
// A figure cut into regions, each with its explanation beside or under it (see AnnotPart).
// layout: "cols" (regions side by side, notes under), "rows" (note beside each region),
// "stack" (note under each full-width region), "side" (one region, notes beside it).
// whole: on phones, show the whole mobile figure once and only the notes of each part. For one-panel diagrams cut
// into steps with xr/yr, whose mobile version is laid out differently and cannot be cut the same way.
// textHead: print "Figure n · title" and the subtitle as page text above the parts instead of cropping the image's
// own title block (the full-size image keeps it). The line links to the full-size image.
import {localeFromPath} from '../i18n/index';
import {figureSpec,headerCrop,wholeCrop,cropStyle,hasMobile} from './annot';
import {tr} from '@llm-systems/viz';
interface Props{fig:string;n:number;layout:'cols'|'rows'|'stack'|'side';whole?:boolean;textHead?:boolean}
const {fig,n,layout,whole=false,textHead=false}=Astro.props;
const locale=localeFromPath(Astro.url.pathname);
const spec=await figureSpec(fig),alt=tr(spec.alt,locale);
const desk=headerCrop(spec,fig,locale,false),mob=hasMobile(spec)?(whole?wholeCrop(spec,fig,locale,true,textHead):headerCrop(spec,fig,locale,true)):null;
const label=locale==='en'?`Figure ${n}`:`그림 ${n}`,title=tr(spec.title,locale),sub=tr(spec.subtitle,locale);
const d=cropStyle(desk),m=mob&&cropStyle(mob,true);
const full=desk.src;
---
<figure class={`annot annot-${layout}${whole&&mob?' annot-whole':''}`} id={`figure-${n}`} data-figure-id={fig}>
  {textHead?<>
    <a class="annot-head annot-texthead" href={full} aria-label={locale==='en'?`Open full-size figure ${n}: ${title}`:`그림 ${n} 원본 열기: ${title}`}>
      <span class="annot-title"><span class="annot-num">{label}</span> · {title}</span>
      {sub&&<span class="annot-sub">{sub}</span>}
      <span class="annot-alt">{alt}</span>
      {whole&&mob&&m&&<div class="annot-crop annot-mobile" style={m.wrap}><img src={mob.src} style={m.img} alt="" loading="lazy" decoding="async" /></div>}
    </a></>
  :<a class="annot-head" href={full} aria-label={locale==='en'?`Open full-size figure ${n}: ${tr(spec.title,'en')}`:`그림 ${n} 원본 열기: ${tr(spec.title,'ko')}`}>
    <div class={`annot-crop${mob?' annot-desktop':''}`} style={d.wrap}><img src={desk.src} style={d.img} alt={alt} loading="lazy" decoding="async" /></div>
    {mob&&m&&<div class="annot-crop annot-mobile" style={m.wrap}><img src={mob.src} style={m.img} alt={alt} loading="lazy" decoding="async" /></div>}
  </a>}
  <div class="annot-body"><slot /></div>
  {Astro.slots.has('caption')&&<figcaption class="annot-caption"><slot name="caption" /></figcaption>}
</figure>
<style is:global>
  .annot{margin:36px 0;width:min(1016px,calc(100vw - 64px));position:relative;left:50%;transform:translateX(-50%)}
  .annot-crop{position:relative;overflow:hidden;width:100%}
  .annot .annot-crop img{position:absolute;max-width:none;height:auto;display:block;margin:0}
  .annot-head{display:block;margin:0 0 6px}
  .annot-texthead{color:inherit;text-decoration:none;margin:0 0 12px}
  .annot-title{display:block;font-size:17px;font-weight:700;line-height:1.5}
  .annot-num{color:var(--green)}
  .annot-sub{display:block;font-size:14.5px;line-height:1.6;color:#5f6b63;margin-top:2px}
  .annot-texthead:hover .annot-title{text-decoration:underline}
  /* The figure's description stays available to screen readers without being shown. */
  .annot-alt{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .annot-texthead .annot-mobile{margin-top:10px}
  .annot-body{display:grid;gap:22px}
  .annot-cols .annot-body{grid-auto-flow:column;grid-auto-columns:1fr;align-items:start}
  .annot-part{border-top:1px solid var(--line);padding-top:10px}
  /* A stacked crop narrower than the column sits in the middle; its note stays left-aligned. */
  .annot-stack .annot-part .annot-crop{margin-left:auto;margin-right:auto}
  .annot-rows .annot-part{display:grid;grid-template-columns:min(var(--cw),64%) minmax(0,1fr);gap:26px;align-items:center}
  .annot-side .annot-part{display:grid;grid-template-columns:min(var(--cw),62%) minmax(0,1fr);gap:26px;align-items:start}
  .annot-note{border-left:3px solid var(--green);padding-left:14px;font-size:15.5px;line-height:1.85}
  .annot-note>:first-child{margin-top:4px}.annot-note>:last-child{margin-bottom:0}
  .annot-note p{margin:8px 0}
  .annot-caption{margin-top:16px;font-size:14px;line-height:1.8;color:#5f6b63;max-width:760px}
  .annot-mobile{display:none}
  @media (max-width:700px){
    .annot{width:auto;left:auto;transform:none}
    .annot-cols .annot-body{grid-auto-flow:row}
    .annot-rows .annot-part,.annot-side .annot-part{display:block}
    .annot-note{margin-top:10px}
  }
  @media (max-width:600px){.annot-desktop{display:none}.annot-mobile{display:block}.annot-whole .annot-part .annot-crop{display:none}}
</style>
